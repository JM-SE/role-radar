# Copiar a .env para desarrollo local: cp .env.example .env
# El prefijo ROLE_RADAR_ es obligatorio (pydantic-settings).

ROLE_RADAR_ENVIRONMENT=dev
ROLE_RADAR_LOG_LEVEL=INFO

# Base de datos SQLite (default de Fase 1; el dir ./data se crea automáticamente).
ROLE_RADAR_DATABASE_URL=sqlite:///./data/role-radar.db

# Fase 3: fake es el default y no requiere red. Para broker, configurar ambos.
ROLE_RADAR_LLM_PROVIDER=fake
# ROLE_RADAR_BROKER_URL=
# ROLE_RADAR_BROKER_TOKEN=
ROLE_RADAR_BROKER_WORKLOAD=role-radar
ROLE_RADAR_BROKER_STRUCTURED_EXTRACTION_CAPABILITY=structured-extraction
ROLE_RADAR_BROKER_PREFER_WAIT_SECONDS=10
ROLE_RADAR_BROKER_POLL_INTERVAL_SECONDS=1.0
ROLE_RADAR_BROKER_RESULT_TIMEOUT_SECONDS=300.0
ROLE_RADAR_BROKER_SUBMIT_RECONCILE_ATTEMPTS=3

# No usado hasta Fase 7 (notificaciones por Telegram).
# ROLE_RADAR_TELEGRAM_BOT_TOKEN=

# Fase 2: HTTP del collector Greenhouse.
ROLE_RADAR_HTTP_TIMEOUT_SECONDS=30.0
ROLE_RADAR_HTTP_USER_AGENT=role-radar/0.1 (+homelab)
# Reservado para discovery futuro; Fase 2 usa NullSearchProvider.
ROLE_RADAR_TAVILY_API_KEY=
