[Unit]
Description=RoleRadar continuous acquisition (disabled by default)
# Disabled by default: this unit is not enabled by any target.

[Service]
Type=oneshot
ExecStart=/usr/bin/env role-radar continuous-acquisition run
# Acquisition has no search credentials. Jobicy is conditional and uses no secret.
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/role-radar
