[Unit]
Description=RoleRadar continuous source discovery (disabled by default)
# Disabled by default: install/enable explicitly after configuring credentials.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ROLE_RADAR_USER
WorkingDirectory=/ROLE_RADAR_APP_DIR
EnvironmentFile=/etc/role-radar/role-radar.env
Environment=PATH=/ROLE_RADAR_APP_DIR/.venv/bin:/usr/bin
ExecStart=/usr/bin/env role-radar continuous-discovery run --scheduled
LoadCredential=query-hmac:/etc/role-radar/credentials/query-hmac
LoadCredential=brave-free:/etc/role-radar/credentials/brave-free
LoadCredential=tavily-free:/etc/role-radar/credentials/tavily-free
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/ROLE_RADAR_APP_DIR/data
