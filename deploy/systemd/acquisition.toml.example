# Install as /etc/role-radar/acquisition.toml with owner root:role-radar and mode 0640.
# This file contains no credentials. Provider origins and request options are
# owned by the application and cannot be overridden here.
schema_version = 1
config_version = "acquisition-v1"

[discovery]
query_hmac_handle = "query-hmac"

# Worker-only Gmail IMAP descriptor. Credential values are never stored in this
# file; the handles below point to root-managed 0600 systemd credentials.
#
# This initial Gate B profile deliberately enables only Gmail. Keep the search
# capabilities disabled until their credentials and independent smokes are
# explicitly prepared.
# The database Source stores only connection_alias and parser_profile.
[mailboxes.role-radar]
connection_alias = "role-radar"
protocol = "imap"
host = "imap.gmail.com"
port = 993
tls = true
validate_certificate = true
mailbox = "RoleRadar"
readonly = true
auth_mode = "app_password"
username_handle = "gmail-username"
app_password_handle = "gmail-app-password"
# These acknowledgements are required because an app password has mailbox-wide
# scope. Keep them true only while the operator accepts the documented policy.
app_password_2fa_ack = true
app_password_scope_ack = true
app_password_revocation_ack = true
dedicated_account_ack = false
message_hmac_handle = "mailbox-message-hmac"
content_hmac_handle = "mailbox-content-hmac"

[brave_free]
enabled = false
units_limit = 0
version = ""

[tavily_free]
enabled = false
units_limit = 0
version = ""

[brave_paid]
enabled = false
# Paid remains fail-closed unless every price/ceiling gate is reviewed.

# Optional explicit operator acceptance for the disabled-by-default Jobicy source.
# This is not a source URL or a feed override. Keep the real values outside Git.
# [jobicy]
# terms_sha256 = "<MANIFEST_SHA256>"
# reviewed_at = "<REAL_UTC_REVIEW_TIMESTAMP>"
# policy_version = "jobicy-terms-v1"
# fair_use_ack = true
# preserve_destination_ack = true
# no_redistribution_ack = true
