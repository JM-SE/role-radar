# Install as /etc/role-radar/acquisition.toml with owner root and mode 0600.
# This file contains no credentials. Provider origins and request options are
# owned by the application and cannot be overridden here.
schema_version = 1
config_version = "acquisition-v1"

[brave_free]
enabled = true
units_limit = 1000
version = "brave-free-quota-v1"

[tavily_free]
enabled = true
units_limit = 1000
version = "tavily-free-quota-v1"

[brave_paid]
enabled = false
# Paid remains fail-closed unless every price/ceiling gate is reviewed.

# Optional explicit operator acceptance for the disabled-by-default Jobicy source.
# This is not a source URL or a feed override. Keep the real values outside Git.
# [jobicy]
# terms_url = "<REAL_HTTPS_TERMS_URL>"
# reviewed_at = "<REAL_UTC_REVIEW_TIMESTAMP>"
# policy_version = "jobicy-terms-v1"
# fair_use_ack = true
# preserve_destination_ack = true
# no_redistribution_ack = true
