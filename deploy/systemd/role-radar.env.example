# Telegram is disabled unless explicitly enabled.
# ROLE_RADAR_API_PORT must be present and an integer in the range 1..65535.
ROLE_RADAR_API_PORT=8010
ROLE_RADAR_TELEGRAM_PROVIDER=disabled
# ROLE_RADAR_TELEGRAM_BOT_TOKEN=replace-me
# ROLE_RADAR_TELEGRAM_CHAT_ID=replace-me
ROLE_RADAR_SCHEDULE_TIMEZONE=America/Argentina/Buenos_Aires
ROLE_RADAR_SCHEDULE_HOUR_LOCAL=8
ROLE_RADAR_SCHEDULE_MINUTE_LOCAL=0
