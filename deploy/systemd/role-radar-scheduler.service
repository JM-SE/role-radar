[Unit]
Description=Enqueue latest role-radar scheduled slot

[Service]
Type=oneshot
User=ROLE_RADAR_USER
WorkingDirectory=/ROLE_RADAR_APP_DIR
EnvironmentFile=/etc/role-radar/role-radar.env
Environment=PATH=/ROLE_RADAR_APP_DIR/.venv/bin:/usr/bin
ExecStart=/usr/bin/env role-radar run create --reason scheduled --schedule-id daily
